#!/usr/bin/env python3
"""bill-snap CLI - 拍账: 收据解析 + AA 计算器"""
import argparse
import json
import sys
import os

sys.path.insert(0, os.path.dirname(__file__))
import receipt_parser


def cmd_parse(args):
    result = receipt_parser.parse_receipt(args.receipt_id)
    print(json.dumps(result, ensure_ascii=False, indent=2))


def cmd_split(args):
    members = [m.strip() for m in args.members.split(",")]
    if args.mode == "equal":
        result = receipt_parser.split_equal(args.receipt_id, members)
    else:
        assignments = json.loads(args.assignments) if args.assignments else {}
        result = receipt_parser.split_itemized(args.receipt_id, members, assignments)
    print(json.dumps(result, ensure_ascii=False, indent=2))


def cmd_balance(args):
    result = receipt_parser.get_balance(args.group_id)
    print(json.dumps(result, ensure_ascii=False, indent=2))


def main():
    parser = argparse.ArgumentParser(prog="billsnap", description="拍账 - 收据解析 + AA 计算器")
    sub = parser.add_subparsers(dest="command", required=True)

    p_parse = sub.add_parser("parse", help="解析收据")
    p_parse.add_argument("--receipt-id", required=True)
    p_parse.set_defaults(func=cmd_parse)

    p_split = sub.add_parser("split", help="分账")
    p_split.add_argument("--receipt-id", required=True)
    p_split.add_argument("--members", required=True, help="逗号分隔的成员列表")
    p_split.add_argument("--mode", choices=["equal", "itemized"], default="equal")
    p_split.add_argument("--assignments", default=None, help="按明细分配的 JSON")
    p_split.set_defaults(func=cmd_split)

    p_balance = sub.add_parser("balance", help="查看余额")
    p_balance.add_argument("--group-id", required=True)
    p_balance.set_defaults(func=cmd_balance)

    args = parser.parse_args()
    args.func(args)


if __name__ == "__main__":
    main()
